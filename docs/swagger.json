{
    "swagger": "2.0",
    "info": {
        "description": "A production-ready, customizable FizzBuzz REST API with usage statistics.",
        "title": "FizzBuzz API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/fizzbuzz": {
            "get": {
                "description": "Returns numbers from 1 to limit, replacing multiples of int1 by str1, multiples of int2 by str2, and multiples of both by str1+str2.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "fizzbuzz"
                ],
                "summary": "Generate a customized fizzbuzz sequence",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 3,
                        "description": "First divisor",
                        "name": "int1",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 5,
                        "description": "Second divisor",
                        "name": "int2",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 100,
                        "description": "Upper bound (inclusive)",
                        "name": "limit",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "fizz",
                        "description": "Replacement for multiples of int1",
                        "name": "str1",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "buzz",
                        "description": "Replacement for multiples of int2",
                        "name": "str2",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_http.fizzBuzzResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_http.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_http.errorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/statistics": {
            "get": {
                "description": "Returns the request parameters that were used the most, along with their hit count.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get the most frequently requested fizzbuzz parameters",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_http.statisticsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_adapter_http.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_adapter_http.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_adapter_http.fizzBuzzResponse": {
            "type": "object",
            "properties": {
                "result": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "internal_adapter_http.statisticsResponse": {
            "type": "object",
            "properties": {
                "hits": {
                    "type": "integer"
                },
                "int1": {
                    "type": "integer"
                },
                "int2": {
                    "type": "integer"
                },
                "limit": {
                    "type": "integer"
                },
                "str1": {
                    "type": "string"
                },
                "str2": {
                    "type": "string"
                }
            }
        }
    }
}